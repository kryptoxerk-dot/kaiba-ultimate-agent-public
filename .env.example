# Kaiba Ultimate Agent — environment template (copy to .env; never commit .env)
# Names only. Values live in .env (gitignored) or ~/.config/kaiba/.env.
# The agent has full authority; the only hard gate is withdrawal, enforced in the signer
# policy (config/signer-policy.yaml) and by GMGN's API surface, not by an env flag.

# --- Runtime ---
KAIBA_ENV=dev                      # dev | shadow | canary | live (execution size caps per config/risk.yaml)
KAIBA_DATA_DIR=./data
KAIBA_DB_PATH=./data/kaiba.db
KAIBA_LOG_LEVEL=INFO
KAIBA_DASHBOARD_HOST=127.0.0.1
KAIBA_DASHBOARD_PORT=8788
KAIBA_DASHBOARD_PASSWORD=

# --- Telegram (operator surface) ---
TELEGRAM_BOT_TOKEN=                 # @your_kaiba_bot (Hermes gateway uses the same token)
TELEGRAM_BOT_USERNAME=your_kaiba_bot
TELEGRAM_ALLOWED_USERS=             # comma-separated numeric user ids
TELEGRAM_HOME_CHANNEL=              # chat id for alerts/cron delivery
# Telethon userbot for call-room listening (session file lives outside the repo)
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=~/.config/kaiba/telethon.session
TG_CALL_CHANNELS=                   # comma-separated t.me/c/<chat>/<topic> or @channel entries

# --- GMGN (execution + intelligence) ---
GMGN_API_KEY=
GMGN_PRIVATE_KEY=                   # Ed25519 REQUEST-signing key from `gmgn-cli config`, not a wallet key
GMGN_CLI_PATH=                      # optional; defaults to the global npm install (gmgn-cli 1.6.1)
GMGN_ALLOW_AUTOMATED_TRADES=0       # set to 1 only on the execution host

# --- Model providers (Hermes reads its own ~/.hermes/.env; these are for kaiba tools) ---
ANTHROPIC_API_KEY=                  # optional; Hermes uses Claude Code OAuth credentials instead
XAI_API_KEY=                        # optional; x_search per-post billing from 2026-09-21
OPENROUTER_API_KEY=                 # optional third leg

# --- Solana data ---
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TRACKER_API_KEY=
BIRDEYE_API_KEY=
PUMPPORTAL_API_KEY=                 # only needed for metered trade streams / trade API
JUPITER_API_KEY=
BITQUERY_TOKEN=

# --- EVM / Robinhood data ---
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=
BASE_RPC_URL=
ETH_RPC_URL=
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# --- Safety / enrichment (keyless unless set) ---
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
RUGCHECK_JWT=
COINGECKO_API_KEY=
NANSEN_API_KEY=
CIELO_API_KEY=
MOBULA_API_KEY=
CODEX_IO_API_KEY=
TWITTERSCORE_API_KEY=

# --- News / alpha ---
CRYPTOPANIC_API_KEY=
NEWSAPI_KEY=

# --- Observability ---
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
