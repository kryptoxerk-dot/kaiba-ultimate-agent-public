# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*keypair*
*token*.txt
*credential*
*.session
*.session-journal
local-secrets/
secrets/

# --- data and state ---
data/
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
*.ndjson
*.log
logs/
reference/**/logs/

# --- toolchains ---
# Codex P0-5 (2026-09-20): editable installs generate packaging metadata.
*.egg-info/
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# --- scratch ---
_hoodsniper_inspect/
*.tmp

# Private keys. `keys/` holds PUBLIC keys only (see keys/README.md); these patterns exist
# so that a private one copied in by mistake cannot be committed. Added 2026-09-21 after
# noticing only *.pem was covered.
id_rsa
id_ed25519
*_ed25519
*_rsa
*.key
*.ppk
!*.pub

# --- scratch: timestamped editor backups ---
*.bak-*

# --- wallet secrets: private keys / seed phrases must never enter this tree ---
# Added 2026-10-02 after the owner's hunter-wallet file was found untracked but NOT ignored
# in the repo root (moved out to an EFS-encrypted folder outside the repo).
*wallet*.txt
*wallets*.txt
*Wallet*.txt
*seed*.txt
*mnemonic*
*private*key*
*privkey*
secrets/
KaibaSecrets/

# Lead 2026-10-16: agent scratch -- pytest temp dirs and Claude worktrees.
.pytest-tmp*/
.claude/worktrees/
