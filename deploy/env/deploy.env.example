# Template for /etc/kaiba/deploy.env  (root:root 0600)
#
# Deployment facts about THIS host: where it backs up to, which RPC addresses the signer
# may reach, what name the dashboard answers on. Not credentials — those go in core.env,
# hermes.env, dashboard.env and signer.env through deploy/rotate-keys.sh.
#
#   sudo install -m 0600 -o root -g root deploy/env/deploy.env.example /etc/kaiba/deploy.env
#   sudo editor /etc/kaiba/deploy.env
#
# Read by: deploy/install.sh, deploy/backup.sh, kaiba-backup.service.
# Nothing here is baked into a script or a unit; that is the point of this file.

# --- identity of this deployment -----------------------------------------------------
# Used in backup manifests and in the operator scripts' output. No default: name it.
KAIBA_DEPLOYMENT_NAME=

# --- backups -------------------------------------------------------------------------
# PUBLIC age recipient(s), space separated. The private identity lives on your laptop and
# never on this box, so a compromised host yields ciphertext. `age-keygen` makes a pair.
AGE_RECIPIENTS=
# Or a file of recipients, one per line:
AGE_RECIPIENTS_FILE=
# Or gpg instead of age (public key only):
GPG_RECIPIENT=

KAIBA_BACKUP_KEEP_DAYS=14

# Optional offsite push, e.g. "b2:kaiba-backups/<host>". Leave empty for local only.
# rclone's own config goes in /etc/kaiba/rclone.conf, because kaiba-backup.service runs
# with ProtectHome=yes and cannot see /root/.config.
RCLONE_REMOTE=

# --- signer network policy -----------------------------------------------------------
# Addresses the signer may reach, comma or space separated CIDRs. install.sh renders
# these into /etc/systemd/system/kaiba-signer.service.d/10-rpc-allow.conf.
#
# Leave EMPTY if the signer is sign-only (the engine fetches blockhashes and broadcasts).
# Empty means loopback only, which fails closed — the correct default.
#
# If you do set it: resolve the RPC hostnames you actually configured and prefer a
# verified /32 over a guessed /16. A list broad enough to be meaningless is worse than
# switching the signer to PrivateNetwork=yes; see the comments in kaiba-signer.service.
KAIBA_RPC_ALLOW_CIDRS=

# --- dashboard / TLS -------------------------------------------------------------------
# Caddy reads these from its own environment, not from this file — set them with
# `systemctl edit caddy`. They are listed here so one file documents the whole
# deployment.
#   KAIBA_DASHBOARD_HOSTNAME=
#   KAIBA_ACME_EMAIL=
#   KAIBA_DASHBOARD_UPSTREAM=127.0.0.1:8788

# --- hardening escape hatches ----------------------------------------------------------
# Comma-separated unit names that may have W+X memory, for the node-based gmgn-cli.
# Every entry here is a deliberate reduction in hardening: record why in a work log.
# e.g. KAIBA_ALLOW_NODE_JIT=kaiba-engine.service,kaiba-scan.service,kaiba-reconcile.service
KAIBA_ALLOW_NODE_JIT=

# Run the dashboard under its own kaiba-dash identity (set when it is exposed beyond
# loopback/Tailscale). Requires: deploy/bootstrap.sh --separate-dash
KAIBA_SEPARATE_DASH=0
