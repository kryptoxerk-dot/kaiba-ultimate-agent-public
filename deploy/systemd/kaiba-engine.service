[Unit]
# The signal engine loop: reads the candidate stream, runs the lanes, writes signals and
# decisions, and hands intents to the executor. It does not hold keys; the signer does.
Description=Kaiba signal engine and execution planner
Documentation=file:///opt/kaiba/current/docs/runbooks/deploy.md
Wants=network-online.target
After=network-online.target kaiba-ingest.service kaiba-signer.service
PartOf=kaiba.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=kaiba-core
Group=kaiba-core
SupplementaryGroups=kaiba kaiba-state kaiba-signer-ipc
WorkingDirectory=/opt/kaiba/current

EnvironmentFile=/etc/kaiba/core.env
Environment=HOME=/var/lib/kaiba
Environment=KAIBA_CONFIG_DIR=/etc/kaiba
Environment=KAIBA_DATA_DIR=/var/lib/kaiba
Environment=KAIBA_DB_PATH=/var/lib/kaiba/db/kaiba.db
Environment=KAIBA_RISK_PATH=/etc/kaiba/config/risk.yaml
Environment=KAIBA_SIGNER_SOCKET=/run/kaiba/signer/signer.sock
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# The engine asks the signer to sign. It never holds key material itself, so every
# signer-side secret name is unset here even if core.env grows one by accident.
UnsetEnvironment=KAIBA_SIGNER_PASSPHRASE KAIBA_SIGNER_KEYSTORE SOLANA_PRIVATE_KEY EVM_PRIVATE_KEY
UnsetEnvironment=KAIBA_DASHBOARD_PASSWORD AGE_IDENTITY_FILE RCLONE_CONFIG_PASS
UnsetEnvironment=ANTHROPIC_API_KEY OPENROUTER_API_KEY TELEGRAM_BOT_TOKEN TG_API_HASH
UnsetEnvironment=PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONOPTIMIZE

ExecStart=/opt/kaiba/venv/bin/python -I -B -m kaiba.cli.main engine run
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=mixed

# ---- hardening baseline (identical across every kaiba unit) -------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# NOTE: V8 needs W+X. The GMGN execution lane shells out to the node-based gmgn-cli; if
# you enable that lane, apply deploy/systemd/dropins/allow-node-jit.conf to THIS unit.
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# ---- explicit write surface ---------------------------------------------------------
ReadWritePaths=/var/lib/kaiba/db /var/lib/kaiba/cache /var/lib/kaiba/logs /var/lib/kaiba/reports
# /etc/kaiba/config: risk.yaml, which the engine updates when it retunes inside the
# envelope. /run/kaiba/signer: belt and braces for the socket connect — the directory is
# 0750 kaiba-signer:kaiba-signer-ipc, so DAC still refuses any actual write here.
ReadWritePaths=/etc/kaiba/config /run/kaiba/signer
ReadOnlyPaths=/opt/kaiba/current /opt/kaiba/venv /etc/kaiba/policy
InaccessiblePaths=/etc/kaiba/signer /var/lib/kaiba/signer /var/lib/kaiba/backups /var/lib/kaiba/hermes

MemoryMax=768M
CPUQuota=150%
TasksMax=96

[Install]
WantedBy=multi-user.target
