[Unit]
# The deterministic maintenance scheduler (Phase 7, "Operate"): creator history, wallet
# backfill and grading inside a daily credit quota, early-alpha source polls, per-token
# trade follow-up, native price samples, the Helius budget check, the journal hash chain
# and the weekly power report. Without it every intelligence table goes stale unless a
# human types a command. It holds no keys and never trades; config/schedule.yaml sets
# every interval and budget, and `kaiba ops status` shows whether maintenance is happening.
Description=Kaiba maintenance scheduler
Documentation=file:///opt/kaiba/current/docs/runbooks/deploy.md
Wants=network-online.target
After=network-online.target kaiba-ingest.service
PartOf=kaiba.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=kaiba-core
Group=kaiba-core
SupplementaryGroups=kaiba kaiba-state
WorkingDirectory=/opt/kaiba/current

EnvironmentFile=/etc/kaiba/core.env
Environment=HOME=/var/lib/kaiba
Environment=KAIBA_CONFIG_DIR=/etc/kaiba
Environment=KAIBA_DATA_DIR=/var/lib/kaiba
Environment=KAIBA_DB_PATH=/var/lib/kaiba/db/kaiba.db
Environment=KAIBA_RISK_PATH=/etc/kaiba/config/risk.yaml
Environment=KAIBA_SCHEDULE_CONFIG=/etc/kaiba/config/schedule.yaml
Environment=KAIBA_SIGNALS_CONFIG=/etc/kaiba/config/signals.yaml
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# Maintenance reads provider data and writes the database. It never signs or sends
# messages, so the complete non-maintenance secret surface is unset even if core.env
# grows one by accident. Provider read keys (for example HELIUS_API_KEY) remain available.
UnsetEnvironment=GMGN_PRIVATE_KEY
UnsetEnvironment=KAIBA_SIGNER_PASSPHRASE KAIBA_SIGNER_KEYSTORE
UnsetEnvironment=SOLANA_PRIVATE_KEY EVM_PRIVATE_KEY
UnsetEnvironment=KAIBA_DASHBOARD_PASSWORD AGE_IDENTITY_FILE RCLONE_CONFIG_PASS
UnsetEnvironment=HELIUS_WEBHOOK_SECRET ALCHEMY_WEBHOOK_SIGNING_KEY
UnsetEnvironment=CRYPTOPANIC_API_KEY NEWSAPI_KEY XAI_API_KEY ANTHROPIC_API_KEY OPENROUTER_API_KEY
UnsetEnvironment=LANGFUSE_PUBLIC_KEY LANGFUSE_SECRET_KEY TELEGRAM_BOT_TOKEN TG_API_HASH TG_API_ID
UnsetEnvironment=PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONOPTIMIZE

ExecStart=/opt/kaiba/venv/bin/python -I -B -m kaiba.cli.main ops run
Restart=always
RestartSec=5
# stop_grace_s in schedule.yaml (30 s) must stay under this.
TimeoutStopSec=45
KillMode=mixed

# ---- hardening baseline (identical across every kaiba unit) -------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# No node here: every job calls a Python entry point. If a job ever shells out to
# gmgn-cli, apply deploy/systemd/dropins/allow-node-jit.conf to THIS unit.
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# ---- explicit write surface ---------------------------------------------------------
# /var/lib/kaiba/ops holds the per-job and service lock files. It is created here rather
# than listed only in ReadWritePaths: under ProtectSystem=strict a ReadWritePaths entry
# that does not exist fails the unit at start, and the scheduler cannot mkdir it either
# because its parent is read-only in the sandbox. StateDirectory= creates it and chowns it
# to User= before the sandbox is set up. (KAIBA_DATA_DIR=/var/lib/kaiba above, and the
# scheduler puts its locks in $KAIBA_DATA_DIR/ops.)
StateDirectory=kaiba/ops
StateDirectoryMode=0750
ReadWritePaths=/var/lib/kaiba/db /var/lib/kaiba/cache /var/lib/kaiba/logs
ReadOnlyPaths=/opt/kaiba/current /opt/kaiba/venv /etc/kaiba/policy /etc/kaiba/config
InaccessiblePaths=/etc/kaiba/signer /var/lib/kaiba/signer /var/lib/kaiba/backups /var/lib/kaiba/hermes /run/kaiba/signer

MemoryMax=512M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
