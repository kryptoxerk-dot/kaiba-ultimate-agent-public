[Unit]
Description=Kaiba retained Grok methods to research evidence registry

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
ExecStart=/usr/bin/timeout -k 2 50 /usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -I -B -m kaiba.learning.method_intake
TimeoutStartSec=55
MemoryMax=200M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
UMask=0077
