[Unit]
Description=Kaiba twin exits: exit challengers paired with the incumbent on closed paper positions (read-only)

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=PYTHONUNBUFFERED=1
Environment=KAIBA_DATA_DIR=%h/kaiba/data
Environment=KAIBA_DB_PATH=%h/kaiba/data/kaiba.db
ExecStart=/usr/bin/timeout -k 5 1190 /usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -m kaiba.learning.twin_exits once --days 7
TimeoutStartSec=1200
MemoryMax=400M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
