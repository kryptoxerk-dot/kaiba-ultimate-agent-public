[Unit]
Description=Kaiba row retention: bounded, batched deletes of rows past each table's window
# 2026-10-13. Runs outside the ops scheduler: it needs more delete time than the single long
# slot gave it, and at idle IO class it yields the disk to protection and the services.
# Shares one lock with disk_guard's emergency pass. See kaiba/ops/retention.py.

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=KAIBA_ENV=prod
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/kaiba/.venv/bin/python -B -m kaiba.ops.retention --execute
Nice=10
# best-effort, NOT idle: the box's scheduler is mq-deadline, which serves idle-class IO only
# after it ages ~10 s, and /proc/pressure/io sits at 60-85%. MEASURED 2026-10-13: idle class
# deleted 4,124 rows in 417 s; best-effort deleted 136,252 in 120 s.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=768M
# budget_s (600) ends a run well inside this.
TimeoutStartSec=900
