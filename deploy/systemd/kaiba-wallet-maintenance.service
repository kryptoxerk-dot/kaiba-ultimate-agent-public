[Unit]
Description=Refresh bounded research-wallet evidence using its original tape quota
ConditionPathExists=%h/kaiba/data/learning/autolearn/wallet-maintenance/install-complete.json

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=PYTHONUNBUFFERED=1
Environment=KAIBA_DATA_DIR=%h/kaiba/data
Environment=KAIBA_CONFIG_DIR=%h/kaiba/config
Environment=KAIBA_DB_PATH=%h/kaiba/data/kaiba.db
ExecStart=/usr/bin/timeout -k 5 270 /usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -m kaiba.learning.wallet_maintenance --once --state-dir %h/kaiba/data/learning/autolearn --db-path %h/kaiba/data/kaiba.db
TimeoutStartSec=290
MemoryMax=200M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
