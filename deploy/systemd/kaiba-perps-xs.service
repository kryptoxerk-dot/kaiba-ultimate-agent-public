[Unit]
Description=Kaiba perps forward PAPER books: weekly cross-sectional momentum + funding carry on Binance USD-M public data (no key, no orders)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=PYTHONUNBUFFERED=1
Environment=KAIBA_DATA_DIR=%h/kaiba/data
# No EnvironmentFile: public market data only; this job needs no credential and must not see one.
ExecStart=/usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -m kaiba.perps.xs_paper run
TimeoutStartSec=600
MemoryMax=384M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
