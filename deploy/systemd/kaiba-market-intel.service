[Unit]
Description=Kaiba market intel refresh: vendored Aegis collectors, keyless public data only (no orders, no credentials)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=PYTHONUNBUFFERED=1
# Caches land in %h/kaiba/data/market-intel/intel/<key>.json; the dashboard reads them via
# KAIBA_AEGIS_INTEL_DIR. No EnvironmentFile: this job needs no Kaiba credential and must not see one.
Environment=AEGIS_TERMINAL_DATA=%h/kaiba/data/market-intel
ExecStart=/usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -m kaiba.market_intel.refresh
TimeoutStartSec=290
MemoryMax=256M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
