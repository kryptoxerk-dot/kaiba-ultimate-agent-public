[Unit]
Description=Kaiba autonomous paper research and evidence-linked learning

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=PYTHONUNBUFFERED=1
Environment=KAIBA_DATA_DIR=%h/kaiba/data
Environment=KAIBA_CONFIG_DIR=%h/kaiba/config
Environment=KAIBA_DB_PATH=%h/kaiba/data/kaiba.db
ExecStart=/usr/bin/timeout -k 5 900 /usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -m kaiba.learning.autolearn --once --admission-clock
TimeoutStartSec=920
MemoryMax=350M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
