[Unit]
Description=Capture bounded market quotes for Kaiba prospective paper research
ConditionPathExists=%h/kaiba/data/learning/autolearn/state.json

[Service]
Type=oneshot
WorkingDirectory=%h/kaiba
Environment=PYTHONUNBUFFERED=1
Environment=KAIBA_DATA_DIR=%h/kaiba/data
Environment=KAIBA_CONFIG_DIR=%h/kaiba/config
Environment=KAIBA_DB_PATH=%h/kaiba/data/kaiba.db
EnvironmentFile=-%h/.config/kaiba/.env
ExecStart=/usr/bin/timeout -k 5 65 /usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/kaiba/.venv/bin/python -m kaiba.learning.prospective_quotes --once
TimeoutStartSec=75
MemoryMax=200M
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
